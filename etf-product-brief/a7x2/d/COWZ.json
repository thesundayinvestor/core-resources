{"meta":{"ticker":"COWZ","as_of_date":"2026-07-24","performance_as_of":"2026-06-30","generated_at":"2026-07-25 09:17:58"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"COWZ","fund_name":"Pacer US Cash Cows 100 ETF","category":"US Large-Cap Value","issuer":"Pacer","index_name":"Pacer US Cash Cows 100 Index","region":"North America","exchange":"BATS","expense_ratio":0.0049,"aum":18049614060,"holdings_count":103,"inception_date":"2016-12-16","overall_score":4.19961082601055,"overall_rank":711,"sector_diversification_score":6.76727145148356},"description":{"tsi_description":"COWZ is a free cash flow-focused ETF that selects U.S. large- and mid-cap companies with high trailing free cash flow yields relative to enterprise value. The fund tracks the Pacer US Cash Cows 100 Index and uses a rules-based process that emphasizes valuation and cash generation rather than traditional earnings-based metrics. Unlike many broad value ETFs, COWZ excludes Financials and can experience meaningful sector shifts following quarterly reconstitutions. The strategy has historically produced strong exposure to value and free cash flow characteristics, though its backward-looking methodology can lead to higher turnover and delayed adaptation to changing market conditions. Overall, COWZ offers a differentiated and more tactical approach to value investing centered around free cash flow generation.","strategy_steps":["Tracks the Pacer US Cash Cows 100 Index.","Starts with companies in the Russell 1000 Index.","Narrows the eligible universe to the top 400 companies by free float market capitalization.","Excludes Financials sector companies.","Excludes companies with negative consensus estimated earnings or free cash flow over the next two years.","Selects the top 100 companies based on free cash flow yield.","Calculates free cash flow yield using free cash flow divided by enterprise value.","Weights holdings based on free cash flow rather than free cash flow yield.","Caps individual security weights at 2%.","Reconstitutes and rebalances quarterly."],"best_for":["Inflation hedging","Tactical investing","Value exposure"],"strengths":["Free cash flow","Value exposure","Quality metrics"],"watchouts":["Higher turnover","Backward-looking","Sector swings"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"COWZ","values":{"1M":-4.09934447419444E-02,"3M":-0.004027231757599,"6M":3.87000000000002E-02,"1Y":0.155438032261936,"3Y":0.112305947236114,"5Y":9.74110556041501E-02,"10Y":null}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":-3.06554368311209E-02,"3M":-0.155235011742959,"6M":-6.21999999999998E-02,"1Y":-6.65946826962744E-02,"3Y":-9.24677588566065E-02,"5Y":-3.55865132153652E-02,"10Y":null}}]},"factor_analysis":{"target":{"costs":4.30579964850615,"liquidity":7.15289982425308,"risk":7.46924428822496,"size":6.95518453427065,"value":9.65202108963093,"dividends":9.41476274165202,"growth":1.93321616871705,"quality":4.29789103690685,"momentum":1.83040421792619,"sentiment":2.23374340949033,"overall":4.19961082601055},"benchmark":{"costs":9.05096660808436,"liquidity":9.83391915641476,"risk":4.40861159929701,"size":2.16256590509666,"value":4.12390158172232,"dividends":8.89279437609842,"growth":7.46924428822496,"quality":8.50527240773286,"momentum":6.40158172231986,"sentiment":6.27504393673111,"overall":8.97157805799649}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":17.0925810531908},{"label":"Forward P/E","field":"forward_pe_derived","value":12.3738003359279},{"label":"Estimated Dividend Yield","field":"estimated_dividend_yield_custom","value":1.71063171611868E-02},{"label":"Beta","field":"beta_5y_derived","value":0