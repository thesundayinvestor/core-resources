{"meta":{"ticker":"DGRO","as_of_date":"2026-07-29","performance_as_of":"2026-06-30","generated_at":"2026-07-30 08:34:04"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"DGRO","fund_name":"iShares Core Dividend Growth ETF","category":"US Large-Cap Value","issuer":"BlackRock","index_name":"Morningstar US Dividend Growth Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.0008,"aum":42241051665,"holdings_count":397,"inception_date":"2014-06-10","overall_score":9.05639539647577,"overall_rank":50,"sector_diversification_score":6.71462093862817},"description":{"tsi_description":"DGRO is a dividend growth ETF that focuses on U.S. companies with a history of consistently increasing dividends while also screening for financial sustainability. The fund tracks the Morningstar US Dividend Growth Index and combines dividend growth requirements with profitability and payout ratio screens designed to avoid potential yield traps. Unlike many higher-yield dividend ETFs, DGRO maintains meaningful exposure to lower-yielding growth-oriented companies that demonstrate strong earnings growth potential. The strategy uses a dividend-dollar-weighting approach that blends elements of market capitalization and dividend weighting while maintaining broad diversification across the U.S. equity market. Overall, DGRO offers a balanced approach to dividend growth investing with an emphasis on long-term earnings-supported dividend increases.","strategy_steps":["Tracks the Morningstar US Dividend Growth Index.","Selects securities from the Morningstar US Market Index.","Requires companies to have at least five consecutive years of uninterrupted dividend growth.","Screens out companies with dividend yields in the highest 10% of the eligible universe.","Requires positive consensus earnings forecasts.","Requires dividend payout ratios below 75%.","Uses a dividend-dollar-weighting methodology based on shares outstanding and indicated dividend yield.","Caps individual security weights at 3%.","Reconstitutes the index annually after the third Friday in December.","Uses a passive indexing approach to replicate index performance."],"best_for":["Income investors","Dividend exposure","Portfolio income"],"strengths":["Dividend income","Cash generation","Defensive exposure"],"watchouts":["Slower growth","Rate sensitivity","Value traps"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"DGRO","values":{"1M":1.60486995019369E-02,"3M":8.46790074832611E-02,"6M":0.1016,"1Y":0.222618288920864,"3Y":0.163598182529629,"5Y":0.110209005743086,"10Y":0.133719227765956}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":2.63867074127604E-02,"3M":-6.65287725020991E-02,"6M":7.00000000000145E-04,"1Y":5.85573962653685E-04,"3Y":-4.11755235630915E-02,"5Y":-2.27885630764295E-02,"10Y":-0.02027109257228}}]},"factor_analysis":{"target":{"costs":9.17533039647577,"liquidity":8.79471365638767,"risk":9.6352422907489,"size":4.45726872246696,"value":5.44052863436123,"dividends":9.73832599118943,"growth":2.72863436123348,"quality":6.44757709251101,"momentum":6.24933920704846,"sentiment":4.42555066079295,"overall":9.05639539647577},"benchmark":{"costs":9.07224669603524,"liquidity":9.81762114537445,"risk":4.36211453744493,"size":2.14185022026432,"value":4.26696035242291,"dividends":8.9215859030837,"growth":7.4704845814978,"quality":8.50925110132159,"momentum":4.41762114537445,"sentiment":5.97973568281938,"overall":7.45271389867841}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":23.5195500058355},{"label":"Forward P/E","field":"forward_pe_derived","value":18.0434733788164},{"label":"Estimated Dividend Yield","field":"estimated_divid