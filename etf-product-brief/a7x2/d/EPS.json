{"meta":{"ticker":"EPS","as_of_date":"2026-08-07","performance_as_of":"2026-07-31","generated_at":"2026-08-08 09:25:32"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"EPS","fund_name":"WisdomTree U.S. LargeCap Fund","category":"US Large-Cap Blend","issuer":"WisdomTree","index_name":"WisdomTree U.S. LargeCap Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.0008,"aum":1644765247,"holdings_count":506,"inception_date":"2007-02-23","overall_score":9.26200214285714,"overall_rank":40,"sector_diversification_score":6.42363199037884},"description":{"tsi_description":"EPS is a fundamentally weighted large-cap U.S. equity ETF that emphasizes earnings-generating companies trading at relatively attractive valuations. The fund tracks the WisdomTree U.S. LargeCap Index and differs from traditional market-cap-weighted strategies by weighting holdings based on earnings rather than company size. Its methodology incorporates profitability and composite risk screens while maintaining broad exposure to large-cap U.S. equities. Compared to the S&P 500, EPS tends to maintain a modest value tilt through lower relative exposure to some of the market's highest-valued mega-cap growth stocks. Overall, EPS offers a slightly more valuation-conscious alternative to traditional cap-weighted large-cap blend ETFs.","strategy_steps":["Tracks the WisdomTree U.S. LargeCap Index.","Selects the 500 largest U.S. companies with positive cumulative earnings over the prior four fiscal quarters.","Applies quality and momentum screening to remove the bottom decile of eligible companies.","Evaluates quality using return on equity, return on assets, gross profits over assets, and cash flows over assets.","Evaluates momentum using risk-adjusted returns over the prior six- and twelve-month periods.","Weights holdings based on earnings rather than market capitalization.","Uses cumulative earnings generated over the prior four quarters to determine constituent weights.","Reconstitutes annually in December."],"best_for":["Core exposure","Blend investing","Value tilt"],"strengths":["Earnings weighting","Lower valuation","Low cost"],"watchouts":["High overlap","Limited edge","Similar returns"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-07-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"EPS","values":{"1M":1.00525267161744E-02,"3M":4.89043543684755E-02,"6M":9.64412111679116E-02,"1Y":0.214980198585917,"3Y":0.19089479327481,"5Y":0.12554965800014,"10Y":0.145261076877213}},{"label":"SPY","values":{"1M":3.63339086202119E-04,"3M":4.21082513247539E-02,"6M":8.53454222923031E-02,"1Y":0.194955141604811,"3Y":0.192052404906245,"5Y":0.12762724521419,"10Y":0.149905672123843}},{"label":"+/- SPY","values":{"1M":9.68918762997228E-03,"3M":6.79610304372158E-03,"6M":1.10957888756085E-02,"1Y":0.020025056981106,"3Y":-1.15761163143557E-03,"5Y":-2.07758721405016E-03,"10Y":-4.64459524662941E-03}}]},"factor_analysis":{"target":{"costs":9.20634920634921,"liquidity":8.65079365079365,"risk":4.15873015873016,"size":2.48412698412698,"value":5.76190476190476,"dividends":7.52380952380952,"growth":6.58730158730159,"quality":7.88095238095238,"momentum":8.05555555555556,"sentiment":5.19047619047619,"overall":9.26200214285714},"benchmark":{"costs":9.11111111111111,"liquidity":9.82539682539682,"risk":4.46031746031746,"size":2.06349206349206,"value":4.11111111111111,"dividends":8.74603174603175,"growth":7.42857142857143,"quality":8.64285714285714,"momentum":7.1984126984127,"sentiment":5.40476190476191,"overall":9.23912920634921}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":22.7602853441255},{"label":"Forward P/E","field":"forward_pe_derived","value":16.8746350555925},{"label":"Estimated Dividend Yield","field":"estimated_dividend_yield_custom","value":1.16374572058529E-02},{"label":"Beta","field":"beta_5y_derived","value":1.10617233720343},{"