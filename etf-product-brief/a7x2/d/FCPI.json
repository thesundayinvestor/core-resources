{"meta":{"ticker":"FCPI","as_of_date":"2026-05-26","performance_as_of":"2026-04-30","generated_at":"2026-05-27 21:46:03"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"FCPI","fund_name":"Fidelity Stocks for Inflation ETF","category":"US Large-Cap Blend","issuer":"Fidelity","index_name":"Fidelity Stocks for Inflation Factor","region":"Global","exchange":"BATS","expense_ratio":0.0015,"aum":278019142,"holdings_count":105,"inception_date":"2019-11-05","overall_score":9.84809853887399,"overall_rank":1,"sector_diversification_score":7.22699048572859},"description":{"tsi_description":"FCPI is a multi-factor ETF designed to identify large-cap U.S. stocks with strong characteristics for inflationary environments while maintaining broad diversification. The fund combines value, quality, and momentum screens with moderate sector tilts toward areas that have historically performed well during periods of rising inflation. Unlike many competing inflation-focused ETFs, FCPI avoids excessive concentration in Energy by limiting active sector adjustments to +/- 5% relative to its benchmark. The strategy emphasizes strong earnings growth, attractive valuations, and high-quality businesses with solid profitability metrics. FCPI also incorporates momentum signals and semi-annual rebalancing to help maintain exposure to improving companies throughout changing market conditions. Overall, the fund offers a disciplined and balanced approach to inflation-focused investing with lower downside risk than many peers.","strategy_steps":["Selects securities from the 1,000 largest U.S. companies by market capitalization.","Calculates composite scores using equally weighted value, quality, and momentum factors.","Evaluates value characteristics using metrics such as free cash flow yield, earnings yield, and valuation ratios.","Measures quality using profitability, capital efficiency, and balance sheet strength metrics.","Screens momentum using price performance trends and earnings surprise data.","Applies sector-relative scoring so companies compete against peers within the same sector.","Uses a separate scoring framework for bank stocks that emphasizes tangible book value, earnings, return on equity, and debt metrics.","Incorporates a size adjustment factor that allows smaller companies to achieve higher portfolio weights.","Increases exposure to sectors expected to perform well during inflationary environments including Energy, Materials, Consumer Staples, and Health Care.","Adds exposure to Real Assets and Infrastructure-related industries.","Reduces exposure to sectors expected to underperform during rising inflation environments.","Limits active sector deviations to approximately +/- 5% relative to the benchmark index.","Selects approximately 100 holdings based on overall composite factor scores.","Weights holdings according to factor strength and portfolio construction constraints.","Reconstitutes and rebalances the portfolio on a semi-annual schedule in February and August.","Maintains diversified exposure while emphasizing companies with strong earnings growth, attractive valuations, and positive momentum characteristics."],"best_for":["Core exposure","Long-term investors","Portfolio diversification"],"strengths":["Broad diversification","Low cost","Core holdings"],"watchouts":["Market risk","Economic sensitivity","Limited upside"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-04-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"FCPI","values":{"1M":0.07457898957498,"3M":4.70795077163508E-02,"6M":6.84150231521181E-02,"1Y":0.262913311891825,"3Y":0.203311066807964,"5Y":0.148595663845891,"10Y":null}},{"label":"SPY","values":{"1M":0.105092544180696,"3M":0.041490095594757,"6M":5.96805451448039E-02,"1Y":0.310880282775522,"3Y":0.215472118211898,"5Y":0.130255920863021,"10Y":0.15162420098996}},{"label":"+/- SPY","values":{"1M":-3.05135546057163E-02,"3M":5.589412