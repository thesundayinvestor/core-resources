{"meta":{"ticker":"FDVV","as_of_date":"2026-07-28","performance_as_of":"2026-06-30","generated_at":"2026-07-29 09:06:47"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"FDVV","fund_name":"Fidelity High Dividend ETF","category":"US Large-Cap Value","issuer":"Fidelity","index_name":"Fidelity High Dividend Index","region":null,"exchange":"NYSEARCA","expense_ratio":0.0015,"aum":10006374670,"holdings_count":112,"inception_date":"2016-09-12","overall_score":9.73083262114537,"overall_rank":7,"sector_diversification_score":6.47952060976833},"description":{"tsi_description":"FDVV is a dividend-focused large-cap ETF that emphasizes companies with attractive combinations of dividend yield, payout sustainability, and dividend growth characteristics. The fund tracks the Fidelity High Dividend Index and uses a multi-factor selection process designed to balance income generation with growth and quality considerations. Unlike many traditional high-yield dividend ETFs, FDVV maintains meaningful exposure to mega-cap growth stocks alongside more defensive income-oriented holdings, resulting in a more balanced sector profile across market environments. The strategy also incorporates sector and size adjustments to avoid excessive concentration in traditionally high-yield industries. Overall, FDVV offers a diversified and growth-aware approach to dividend investing.","strategy_steps":["Tracks the Fidelity High Dividend Index.","Starts with dividend-paying stocks in the developed U.S. equity universe.","Excludes securities outside the top 1,000 companies by market capitalization.","Excludes securities with payout ratios in the top 5% of the eligible universe.","Calculates composite scores using dividend yield (70%), payout ratio (15%), and dividend growth (15%).","Defines dividend yield as trailing twelve-month dividends divided by price per share.","Defines payout ratio as trailing twelve-month dividends divided by earnings per share.","Defines dividend growth as trailing twelve-month dividends relative to dividends paid one year earlier.","Blends composite scores with a size factor to reduce size bias.","Compares securities against sector peers during the ranking process.","Uses sector adjustments to overweight sectors with higher dividend yields while maintaining broad diversification.","Weights holdings using market capitalization and sector-adjusted factors.","Reconstitutes annually in February.","Uses a passive indexing approach to replicate index performance."],"best_for":["Dividend growth","Core income","Balanced exposure"],"strengths":["Balanced strategy","GARP profile","Sector diversification"],"watchouts":["Energy underweight","Higher volatility","Stronger peers"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"FDVV","values":{"1M":-1.34136326307144E-02,"3M":0.100906221362387,"6M":8.12000000000004E-02,"1Y":0.194568475682487,"3Y":0.186334201383305,"5Y":0.133870135382454,"10Y":null}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":-3.07562471989087E-03,"3M":-5.03015586229731E-02,"6M":-1.96999999999996E-02,"1Y":-2.74642392757232E-02,"3Y":-0.018439504709415,"5Y":8.72566562938326E-04,"10Y":null}}]},"factor_analysis":{"target":{"costs":8.45374449339207,"liquidity":9.22290748898678,"risk":7.64493392070485,"size":3.20440528634361,"value":6.89162995594714,"dividends":9.95242290748899,"growth":5.35330396475771,"quality":6.86784140969163,"momentum":8.65991189427313,"sentiment":1.51541850220264,"overall":9.73083262114537},"benchmark":{"costs":9.07224669603524,"liquidity":9.83348017621145,"risk":4.36211453744493,"size":2.14185022026432,"value":4.2511013215859,"dividends":8.9215859030837,"growth":7.51013215859031,"quality":8.52511013215859,"m