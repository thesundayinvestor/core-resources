{"meta":{"ticker":"GRNY","as_of_date":"2026-08-07","performance_as_of":"2026-07-31","generated_at":"2026-08-09 18:16:12"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"GRNY","fund_name":"Fundstrat Granny Shots US Large Cap ETF","category":"US Large-Cap Growth","issuer":"Fundstrat","index_name":null,"region":"North America","exchange":"NYSEARCA","expense_ratio":0.0075,"aum":4332796440,"holdings_count":46,"inception_date":"2024-11-07","overall_score":1.85150176678445,"overall_rank":1040,"sector_diversification_score":6.74084450267056},"description":{"tsi_description":"GRNY is an actively managed large-cap growth ETF that uses a thematic and rules-based framework to identify stocks tied to multiple macroeconomic and structural trends. Led by Tom Lee and Fundstrat Capital, the strategy differs substantially from traditional passive growth ETFs by emphasizing thematic diversification, equal weighting, and lower overlap with mega-cap-heavy benchmarks like QQQ. The fund combines longer-term themes such as Millennials, Energy and Cybersecurity, and Global Labor Suppliers with shorter-term themes tied to Style Tilt, Seasonality, and PMI Recovery. While GRNY has delivered strong returns since inception, its reliance on forward growth expectations, thematic positioning, and higher-risk stocks introduces greater uncertainty than many passive growth peers. Overall, GRNY offers a differentiated and actively managed approach to thematic large-cap growth investing.","strategy_steps":["Actively managed by Fundstrat Capital using a thematic investment framework.","Assigns stocks to short-term and long-term macroeconomic and structural themes.","Requires stocks to qualify under at least two themes for portfolio inclusion.","Uses themes including Style Tilt, Seasonality, PMI Recovery, Energy and Cybersecurity, Millennials, Global Labor Suppliers, and Easing Financial Conditions.","Applies secondary quantitative screening after theme assignment.","Targets approximately 20-50 holdings across 5-10 themes.","Uses an equal-weighting approach across portfolio holdings.","Rebalances quarterly.","Adjusts portfolio composition based on changes in theme qualification and portfolio manager positioning."],"best_for":["Satellite exposure","Active growth","Thematic investing"],"strengths":["Low overlap","Unique strategy","Active themes"],"watchouts":["High fees","Speculative tilt","Untested strategy"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-07-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"GRNY","values":{"1M":-0.023089314480043,"3M":1.34620740878284E-02,"6M":6.99862772005488E-02,"1Y":0.151125673253833,"3Y":null,"5Y":null,"10Y":null}},{"label":"SPY","values":{"1M":3.63339086202119E-04,"3M":4.21082513247539E-02,"6M":8.53454222923031E-02,"1Y":0.194955141604811,"3Y":0.192052404906245,"5Y":0.12762724521419,"10Y":0.149905672123843}},{"label":"+/- SPY","values":{"1M":-2.34526535662452E-02,"3M":-2.86461772369255E-02,"6M":-1.53591450917543E-02,"1Y":-4.38294683509777E-02,"3Y":null,"5Y":null,"10Y":null}}]},"factor_analysis":{"target":{"costs":1.8904593639576,"liquidity":9.06183745583039,"risk":3.75088339222615,"size":3.96554770318021,"value":2.10512367491166,"dividends":2.12102473498233,"growth":7.44787985865724,"quality":7.25706713780919,"momentum":2.76501766784452,"sentiment":7.43197879858657,"overall":1.85150176678445},"benchmark":{"costs":9.1095406360424,"liquidity":9.83303886925795,"risk":4.32332155477032,"size":2.09717314487633,"value":4.13250883392226,"dividends":8.73586572438163,"growth":7.54328621908127,"quality":8.67226148409894,"momentum":6.81978798586572,"sentiment":5.92137809187279,"overall":9.1434690459364}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":27.8230359499179},{"label":"Forward P/E","field":"forward_pe_derived","value":21.9248806331155},{"label":"Estimated Dividend Yield","field":"estimate