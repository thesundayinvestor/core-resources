{"meta":{"ticker":"IDMO","as_of_date":"2026-09-08","performance_as_of":"2026-08-31","generated_at":"2026-09-09 14:48:21"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"IDMO","fund_name":"Invesco S&P International Developed Momentum ETF","category":"Intl Large-Cap Blend","issuer":"Invesco","index_name":"S&P World Ex-U.S. Momentum Index","region":"Global","exchange":"NYSEARCA","expense_ratio":0.0025,"aum":4388355950,"holdings_count":226,"inception_date":"2012-02-24","overall_score":8.05947128742515,"overall_rank":48,"sector_diversification_score":5.13832533013205},"description":{"tsi_description":"IDMO is an international momentum ETF that tracks the S&P World Ex-U.S. Momentum Index and invests in developed-market stocks exhibiting the strongest price momentum characteristics. The strategy applies a transparent momentum methodology that selects securities based on twelve-month price performance while excluding the most recent month. Unlike broader international equity ETFs, IDMO concentrates its holdings in stocks demonstrating sustained relative strength, which can result in meaningful sector deviations from the broader market. The fund also combines momentum-based selection with market-cap weighting adjustments, giving greater influence to larger companies with stronger momentum scores. Overall, IDMO offers targeted exposure to international momentum stocks through a disciplined rules-based framework.","strategy_steps":["Tracks the S&P World Ex-U.S. Momentum Index.","Starts with the S&P World Ex-U.S. Index, consisting of developed-market large- and mid-cap stocks excluding the U.S. and Korea.","Requires at least twelve months of trading history for eligibility.","Calculates momentum scores using twelve-month price returns excluding the most recent month in local currency.","Selects the top quintile of securities based on momentum scores.","Applies buffer rules allowing certain existing constituents to remain in the Index to reduce turnover.","Weights securities using the product of momentum score and market capitalization.","Caps individual security weights at the lower of 9% or three times their market-cap weight.","Rebalances semi-annually after the third Friday of March and September."],"best_for":["Momentum exposure","International equities","Satellite allocation"],"strengths":["Strong momentum","Proven process","Long track record"],"watchouts":["Sector concentration","Developed only","Korea exclusion"],"status":"complete","last_updated":"2026-05-29"},"performance":{"as_of":"2026-08-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"IDMO","values":{"1M":2.62087663804786E-02,"3M":3.87887658951602E-02,"6M":5.33779590806212E-02,"1Y":0.224890282990394,"3Y":0.260867547000796,"5Y":0.150481309387736,"10Y":0.128735269973237}},{"label":"SPY","values":{"1M":2.67865250158903E-02,"3M":1.65408126573174E-02,"6M":0.124055666003976,"1Y":0.202293314227892,"3Y":0.209188792743868,"5Y":0.126975306348125,"10Y":0.152811385025648}},{"label":"+/- SPY","values":{"1M":-5.77758635411652E-04,"3M":2.22479532378428E-02,"6M":-7.06777069233546E-02,"1Y":2.25969687625029E-02,"3Y":5.16787542569277E-02,"5Y":2.35060030396113E-02,"10Y":-2.40761150524114E-02}}]},"factor_analysis":{"target":{"costs":7.73652694610778,"liquidity":8.43712574850299,"risk":4.2065868263473,"size":6.87425149700599,"value":5.82335329341317,"dividends":8.08682634730539,"growth":5.82335329341317,"quality":2.29341317365269,"momentum":8.97604790419162,"sentiment":9.35329341317365,"overall":8.05947128742515},"benchmark":{"costs":8.9317980513729,"liquidity":9.82462356067316,"risk":4.44375553587245,"size":2.12400354295837,"value":4.10894596988485,"dividends":8.72453498671391,"growth":7.40921169176262,"quality":8.56510186005315,"momentum":7.31355181576617,"sentiment":5.12134632418069,"overall":9.22638419840567}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":16.2669740975436},{"la