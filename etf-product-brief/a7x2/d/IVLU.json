{"meta":{"ticker":"IVLU","as_of_date":"2026-07-27","performance_as_of":"2026-06-30","generated_at":"2026-07-28 08:55:01"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"IVLU","fund_name":"iShares MSCI Intl Value Factor ETF","category":"Intl Large-Cap Value","issuer":"BlackRock","index_name":"MSCI World ex USA Enhanced Value","region":"Global","exchange":"NYSEARCA","expense_ratio":0.003,"aum":4280861074,"holdings_count":369,"inception_date":"2015-06-16","overall_score":9.81215118343195,"overall_rank":1,"sector_diversification_score":7.08483805668016},"description":{"tsi_description":"IVLU is an international value ETF that tracks the MSCI World ex USA Enhanced Value Index and targets developed-market companies trading at attractive valuations relative to their sector peers. The strategy uses a sector-neutral approach that seeks to isolate the value factor while maintaining broad diversification across countries and industries. Unlike many international value ETFs, IVLU excludes emerging markets and focuses exclusively on developed-market stocks, resulting in a distinct regional profile. The fund combines multiple valuation metrics and applies weighting adjustments designed to avoid excessive sector bets relative to its parent index. Overall, IVLU offers a disciplined and diversified approach to international value investing.","strategy_steps":["Tracks the MSCI World ex USA Enhanced Value Index.","Starts with the MSCI World ex USA Index, representing approximately 85% of the free-float market capitalization of 22 developed markets.","Calculates value scores using price-to-book, forward price-to-earnings, and enterprise value-to-cash flow from operations ratios.","Uses modified valuation inputs for Financials and Real Estate securities.","Winsorizes individual factor scores at +/- 3 to limit the impact of outliers.","Selects a fixed number of securities representing approximately 30% of the parent index's float-adjusted market capitalization.","Determines initial weights using market capitalization and value scores.","Adjusts weights to maintain sector neutrality relative to the parent index.","Applies buffer rules to reduce portfolio turnover.","Rebalances semi-annually at the end of May and November."],"best_for":["International value","Core allocation","Developed markets"],"strengths":["Sector neutral","Strong diversification","Value exposure"],"watchouts":["No Korea exposure","Developed only","Competitive category"],"status":"complete","last_updated":"2026-05-28"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"IVLU","values":{"1M":-1.00106307583275E-02,"3M":7.15323095185942E-02,"6M":0.117500000000001,"1Y":0.316678745238197,"3Y":0.229685173910883,"5Y":0.147751352061206,"10Y":0.114188599701918}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":3.27377152495978E-04,"3M":-7.96754704667659E-02,"6M":1.66000000000006E-02,"1Y":9.46460302799872E-02,"3Y":2.49114678181626E-02,"5Y":1.47537832416911E-02,"10Y":-3.98017206363181E-02}}]},"factor_analysis":{"target":{"costs":7.28402366863905,"liquidity":8.42899408284024,"risk":8.69526627218935,"size":7.49704142011834,"value":9.12130177514793,"dividends":9.81360946745562,"growth":2.27810650887574,"quality":1.39940828402367,"momentum":9.54733727810651,"sentiment":8.40236686390532,"overall":9.81215118343195},"benchmark":{"costs":9.07387862796834,"liquidity":9.83377308707124,"risk":4.35620052770449,"size":2.14775725593668,"value":4.20580474934037,"dividends":8.88390501319261,"growth":7.53034300791557,"quality":8.5197889182058,"momentum":5.41688654353562,"sentiment":6.18469656992084,"overall":8.3786668469657}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":13.254653280118},{"label":"Forwa