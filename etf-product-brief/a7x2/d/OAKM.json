{"meta":{"ticker":"OAKM","as_of_date":"2026-08-17","performance_as_of":"2026-07-31","generated_at":"2026-08-18 08:26:42"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"OAKM","fund_name":"Oakmark U.S. Large Cap ETF","category":"US Large-Cap Value","issuer":"Oakmark","index_name":null,"region":"North America","exchange":"NYSEARCA","expense_ratio":0.0059,"aum":1164047255,"holdings_count":41,"inception_date":"2024-12-03","overall_score":5.43997349823321,"overall_rank":545,"sector_diversification_score":6.49994965767217},"description":{"tsi_description":"OAKM is an actively managed large-cap value ETF that seeks to identify companies trading at discounts to management's estimates of intrinsic value. Managed by Oakmark's long-standing investment team, the fund uses a bottom-up approach that emphasizes valuation, shareholder-oriented management teams, and businesses with durable free cash flow and earnings characteristics. Unlike many passive value ETFs, OAKM maintains a concentrated portfolio that can result in meaningful sector and factor deviations from traditional benchmarks. The strategy has recently emphasized Financials and Energy stocks, contributing to a lower valuation profile but also introducing higher earnings variability than many peers. Overall, OAKM offers a concentrated and actively managed approach to large-cap value investing.","strategy_steps":["Actively managed by Harris Associates using the Oakmark value investment philosophy.","Seeks companies trading at discounts to estimates of intrinsic value.","Evaluates companies based on free cash flow generation and earnings durability.","Looks for businesses expected to grow shareholder value over time.","Evaluates management alignment through insider ownership and performance-based incentives.","Uses a bottom-up fundamental research process.","Maintains a concentrated portfolio of approximately 30-40 holdings.","Allows significant sector deviations relative to traditional benchmarks.","Adjusts portfolio positioning based on management's assessment of valuation and opportunity.","Uses an active management approach rather than tracking a passive index."],"best_for":["Active value","Contrarian investing","Concentrated exposure"],"strengths":["Deep value","Active management","Experienced team"],"watchouts":["Sector concentration","Earnings variability","Stronger peers"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-07-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"OAKM","values":{"1M":7.09755360918154E-02,"3M":6.57182929272691E-02,"6M":6.11471321695762E-02,"1Y":0.166688998377726,"3Y":null,"5Y":null,"10Y":null}},{"label":"SPY","values":{"1M":3.63339086202119E-04,"3M":4.21082513247539E-02,"6M":8.53454222923031E-02,"1Y":0.194955141604811,"3Y":0.192052404906245,"5Y":0.12762724521419,"10Y":0.149905672123843}},{"label":"+/- SPY","values":{"1M":7.06121970056133E-02,"3M":2.36100416025151E-02,"6M":-2.41982901227269E-02,"1Y":-2.82661432270848E-02,"3Y":null,"5Y":null,"10Y":null}}]},"factor_analysis":{"target":{"costs":3.21819787985866,"liquidity":7.00265017667845,"risk":5.86572438162544,"size":5.56360424028269,"value":8.95848056537102,"dividends":3.83833922261484,"growth":3.39310954063604,"quality":5.46819787985866,"momentum":5.65901060070671,"sentiment":7.94081272084806,"overall":5.43997349823321},"benchmark":{"costs":8.93462897526502,"liquidity":9.80918727915194,"risk":4.66519434628975,"size":2.136925795053,"value":4.19611307420495,"dividends":8.71201413427562,"growth":7.40812720848056,"quality":8.5291519434629,"momentum":4.77650176678445,"sentiment":5.14222614840989,"overall":7.90653409893993}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":18.915548709973},{"label":"Forward P/E","field":"forward_pe_derived","value":12.8695025912371},{"label":"Estimated Dividend Yield","field":"estimated_dividend_yield_custom","value":8.23471264599