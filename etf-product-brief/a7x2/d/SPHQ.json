{"meta":{"ticker":"SPHQ","as_of_date":"2026-09-08","performance_as_of":"2026-08-31","generated_at":"2026-09-09 14:48:21"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"SPHQ","fund_name":"Invesco S&P 500 Quality ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"S&P 500 Quality","region":"North America","exchange":"NYSEARCA","expense_ratio":0.0015,"aum":18921736485,"holdings_count":102,"inception_date":"2005-12-06","overall_score":6.79936234720992,"overall_rank":342,"sector_diversification_score":5.40273600645344},"description":{"tsi_description":"SPHQ is a quality-focused large-cap ETF that tracks the S&P 500 Quality Index and emphasizes companies with strong profitability and balance sheet characteristics. The fund uses a rules-based approach centered around return on equity, accruals, and financial leverage metrics to identify higher-quality businesses within the S&P 500 universe. Unlike broader market ETFs, SPHQ tends to maintain lower exposure to some mega-cap growth stocks while overweighting sectors such as Industrials and Consumer Staples based on its quality screens. The strategy has historically produced competitive returns with somewhat lower portfolio risk and differentiated sector exposure relative to the S&P 500. Overall, SPHQ offers a distinct approach to quality investing that differs meaningfully from both cap-weighted and sector-neutral alternatives.","strategy_steps":["Tracks the S&P 500 Quality Index.","Starts with companies in the S&P 500 Index.","Calculates quality scores using return on equity, accruals ratio, and financial leverage ratio.","Defines return on equity as trailing twelve-month earnings per share divided by book value per share.","Defines accruals ratio as the change in net operating assets divided by average total assets.","Defines financial leverage as total debt divided by book value.","Selects 100 stocks based on composite quality scores.","Uses a 20% buffer rule allowing existing holdings ranked in the top 120 to remain in the Index.","Weights holdings based on the product of market capitalization and quality score.","Limits individual security weights to the lower of 5% or 20x their market-cap weight.","Limits sector weights to 40% using the GICS classification system.","Reconstitutes semi-annually after the third Friday in June and December."],"best_for":["Quality exposure","Core enhancement","Risk reduction"],"strengths":["High profitability","Strong quality","Sometimes lower beta"],"watchouts":["Premium valuation","Sector tilts","Momentum lag"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-08-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"SPHQ","values":{"1M":8.63436123348027E-03,"3M":2.80308339173096E-03,"6M":6.14742698191935E-02,"1Y":0.194020030997913,"3Y":0.190723823087332,"5Y":0.124088218957707,"10Y":0.145274695577719}},{"label":"SPY","values":{"1M":2.67865250158903E-02,"3M":1.65408126573174E-02,"6M":0.124055666003976,"1Y":0.202293314227892,"3Y":0.209188792743868,"5Y":0.126975306348125,"10Y":0.152811385025648}},{"label":"+/- SPY","values":{"1M":-0.01815216378241,"3M":-1.37377292655865E-02,"6M":-6.25813961847823E-02,"1Y":-0.008273283229979,"3Y":-1.84649696565367E-02,"5Y":-2.88708739041788E-03,"10Y":-7.53668944792962E-03}}]},"factor_analysis":{"target":{"costs":8.52524357838795,"liquidity":9.08325952170062,"risk":5.12134632418069,"size":4.69884853852967,"value":3.35961027457927,"dividends":6.37289636846767,"growth":5.44818423383525,"quality":9.28255093002657,"momentum":4.50752878653676,"sentiment":3.47121346324181,"overall":6.79936234720992},"benchmark":{"costs":8.9317980513729,"liquidity":9.82462356067316,"risk":4.44375553587245,"size":2.12400354295837,"value":4.10894596988485,"dividends":8.72453498671391,"growth":7.40921169176262,"quality":8.56510186005315,"momentum":7.31355181576617,"sentiment":5.12134632418069,"overall":9.22638419840567}},"portfolio_charact