{"meta":{"ticker":"SPMO","as_of_date":"2026-10-02","performance_as_of":"2026-09-30","generated_at":"2026-10-03 08:45:39"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"SPMO","fund_name":"Invesco S&P 500 Momentum ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"S&P 500 Momentum Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.0013,"aum":23243006066,"holdings_count":102,"inception_date":"2015-10-09","overall_score":7.112,"overall_rank":296,"sector_diversification_score":5.36057090783459},"description":{"tsi_description":"SPMO is a momentum-focused ETF that tracks the S&P 500 Momentum Index and emphasizes large-cap U.S. stocks with strong recent price performance. The strategy selects companies based on one-year momentum signals while incorporating volatility adjustments and market capitalization into the weighting process. Unlike pure equal-weight momentum strategies, SPMO tends to allocate more heavily toward larger and more profitable companies, resulting in stronger quality characteristics than many momentum peers. The fund can experience substantial portfolio turnover and sector shifts following its semi-annual reconstitutions, particularly when market leadership changes rapidly. Overall, SPMO offers concentrated exposure to momentum-driven trends within the S&P 500 universe.","strategy_steps":["Tracks the S&P 500 Momentum Index.","Starts with companies in the S&P 500 Index.","Assigns momentum scores based on one-year price returns excluding the most recent month.","Adjusts momentum scores based on stock volatility.","Selects approximately 100 stocks with the highest momentum scores.","Uses a 25% buffer rule allowing certain existing constituents to remain in the index.","Weights holdings based on the product of momentum scores and market capitalization.","Caps individual positions at the lower of 9% or three times the stock's market-cap weight.","Reconstitutes and rebalances semi-annually after the third Friday in March and September."],"best_for":["Momentum exposure","Growth investing","Satellite allocation"],"strengths":["Strong momentum","Quality tilt","GARP profile"],"watchouts":["High turnover","Sector concentration","Valuation risk"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-09-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"SPMO","values":{"1M":3.22267991276957E-02,"3M":-6.00867838493787E-02,"6M":0.356399915092337,"1Y":0.265257597086743,"3Y":0.393150352555448,"5Y":0.215841271101475,"10Y":0.200711316413422}},{"label":"SPY","values":{"1M":-3.27201980898484E-03,"3M":2.37987101462438E-02,"6M":0.178605040259332,"1Y":0.157157102167488,"3Y":0.22757633319144,"5Y":0.137031443094805,"10Y":0.15242468944859}},{"label":"+/- SPY","values":{"1M":3.54988189366805E-02,"3M":-8.38854939956225E-02,"6M":0.177794874833004,"1Y":0.108100494919255,"3Y":0.165574019364008,"5Y":7.88098280066702E-02,"10Y":4.82866269648323E-02}}]},"factor_analysis":{"target":{"costs":8.61968085106383,"liquidity":9.80851063829787,"risk":1.88563829787234,"size":3.28191489361702,"value":3.80053191489362,"dividends":5.22872340425532,"growth":7.36702127659574,"quality":7.40691489361702,"momentum":8.81914893617021,"sentiment":3.79255319148936,"overall":7.112},"benchmark":{"costs":9.12234042553191,"liquidity":9.83244680851064,"risk":4.31914893617021,"size":2.18085106382979,"value":3.86436170212766,"dividends":8.57978723404255,"growth":7.47074468085106,"quality":8.55585106382979,"momentum":8.31648936170213,"sentiment":5.33244680851064,"overall":9.67348563829787}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":26.6495076079842},{"label":"Forward P/E","field":"forward_pe_derived","value":17.7393308819546},{"label":"Estimated Dividend Yield","field":"estimated_dividend_yield_custom","value":7.3920466880636E-03},{"label":"Beta","field":"beta_5y_derived","value":1.33599591333552},