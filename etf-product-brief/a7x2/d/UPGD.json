{"meta":{"ticker":"UPGD","as_of_date":"2026-10-19","performance_as_of":"2026-09-30","generated_at":"2026-10-20 08:42:10"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":110421640,"holdings_count":52,"inception_date":"2006-05-19","overall_score":3.69154360838537,"overall_rank":781,"sector_diversification_score":5.74367873574715},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-09-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":-3.44149459193707E-02,"3M":-2.45620372042621E-02,"6M":0.096872461413485,"1Y":8.57048954541815E-02,"3Y":0.144284684482728,"5Y":6.81374963186514E-02,"10Y":8.98991113999059E-02}},{"label":"SPY","values":{"1M":-3.27201980898484E-03,"3M":2.37987101462438E-02,"6M":0.178605040259332,"1Y":0.157157102167488,"3Y":0.22757633319144,"5Y":0.137031443094805,"10Y":0.15242468944859}},{"label":"+/- SPY","values":{"1M":-3.11429261103858E-02,"3M":-4.83607473505059E-02,"6M":-8.17325788458474E-02,"1Y":-7.14522067133065E-02,"3Y":-8.32916487087121E-02,"5Y":-6.88939467761533E-02,"10Y":-0.062525578048684}}]},"factor_analysis":{"target":{"costs":5.10258697591436,"liquidity":3.6413916146298,"risk":7.26226583407672,"size":6.54772524531668,"value":4.33987511150758,"dividends":8.35414808206958,"growth":2.13202497769848,"quality":4.79750223015165,"momentum":5.82515611061552,"sentiment":3.12756467439786,"overall":3.69154360838537},"benchmark":{"costs":8.91614629794826,"liquidity":9.84745762711864,"risk":4.40410347903657,"size":2.07582515611062,"value":3.86619090098127,"dividends":8.57894736842105,"growth":7.64763603925067,"quality":8.61909009812667,"momentum":8.30597680642284,"sentiment":5.52007136485281,"overall":9.55698032560214}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":23.8525209360269},{"label":"Forward P/E","field":"forward_pe_derived","value":19.3360035447887},{"label":"Est