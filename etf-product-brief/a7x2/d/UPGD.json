{"meta":{"ticker":"UPGD","as_of_date":"2026-07-20","performance_as_of":"2026-06-30","generated_at":"2026-07-21 08:24:48"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":118267680,"holdings_count":53,"inception_date":"2006-05-19","overall_score":2.89422500878735,"overall_rank":901,"sector_diversification_score":5.8816244873462},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":1.806358381502E-04,"3M":0.124492282696994,"6M":0.1074,"1Y":0.17457480372671,"3Y":0.137304144915486,"5Y":6.83886671820724E-02,"10Y":0.103426929237761}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":1.05186437489737E-02,"3M":-2.67154972883661E-02,"6M":6.49999999999995E-03,"1Y":-4.74579112314999E-02,"3Y":-6.74695611772342E-02,"5Y":-6.46089016374429E-02,"10Y":-0.050563391100475}}]},"factor_analysis":{"target":{"costs":5.28646748681898,"liquidity":3.1274165202109,"risk":8.4182776801406,"size":6.71001757469244,"value":6.04569420035149,"dividends":9.2170474516696,"growth":2.0597539543058,"quality":4.25043936731107,"momentum":2.39191564147627,"sentiment":1.77504393673111,"overall":2.89422500878735},"benchmark":{"costs":9.07469244288225,"liquidity":9.80228471001757,"risk":4.64586994727592,"size":2.09929701230228,"value":4.10808435852373,"dividends":8.81370826010545,"growth":7.22407732864675,"quality":8.51318101933216,"momentum":6.05360281195079,"sentiment":4.40070298769772,"overall":8.28612643233743}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":22.3792007975024},{"label":"Forward P/E","field":"forward_pe_derived","value":18.4586813965054},{"label":"Estimated Dividend Yield","field":"estimated_divi