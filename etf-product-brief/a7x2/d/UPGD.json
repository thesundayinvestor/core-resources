{"meta":{"ticker":"UPGD","as_of_date":"2026-07-13","performance_as_of":"2026-06-30","generated_at":"2026-07-14 08:39:53"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":118650086,"holdings_count":54,"inception_date":"2006-05-19","overall_score":2.95864035242291,"overall_rank":888,"sector_diversification_score":5.86887311268873},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":1.806358381502E-04,"3M":0.124492282696994,"6M":0.1074,"1Y":0.17457480372671,"3Y":0.137304144915486,"5Y":6.83886671820724E-02,"10Y":0.103426929237761}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":1.05186437489737E-02,"3M":-2.67154972883661E-02,"6M":6.49999999999995E-03,"1Y":-4.74579112314999E-02,"3Y":-6.74695611772342E-02,"5Y":-6.46089016374429E-02,"10Y":-0.050563391100475}}]},"factor_analysis":{"target":{"costs":5.14713656387665,"liquidity":3.26784140969163,"risk":8.27136563876652,"size":6.63788546255507,"value":6.11453744493392,"dividends":9.12775330396476,"growth":2.12599118942731,"quality":4.13215859030837,"momentum":2.8,"sentiment":1.76916299559471,"overall":2.95864035242291},"benchmark":{"costs":8.9295154185022,"liquidity":9.80969162995595,"risk":4.19559471365639,"size":2.11806167400881,"value":3.99735682819383,"dividends":8.69955947136564,"growth":7.54977973568282,"quality":8.50132158590308,"momentum":7.29603524229075,"sentiment":4.93303964757709,"overall":8.94286337004405}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":22.5098124087942},{"label":"Forward P/E","field":"forward_pe_derived","value":18.3571043959809},{"label":"Estimated Dividend Yield","field":"estimated_dividend_yiel