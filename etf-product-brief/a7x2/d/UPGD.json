{"meta":{"ticker":"UPGD","as_of_date":"2026-08-07","performance_as_of":"2026-07-31","generated_at":"2026-08-08 09:25:32"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":121417026,"holdings_count":53,"inception_date":"2006-05-19","overall_score":3.23431531746032,"overall_rank":852,"sector_diversification_score":5.92982789673804},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-07-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":1.89633375474085E-03,"3M":6.09103078982596E-02,"6M":0.070429329474192,"1Y":0.156910990734032,"3Y":0.120508413986269,"5Y":7.62098009226644E-02,"10Y":9.70940786997749E-02}},{"label":"SPY","values":{"1M":3.63339086202119E-04,"3M":4.21082513247539E-02,"6M":8.53454222923031E-02,"1Y":0.194955141604811,"3Y":0.192052404906245,"5Y":0.12762724521419,"10Y":0.149905672123843}},{"label":"+/- SPY","values":{"1M":1.53299466853873E-03,"3M":1.88020565735056E-02,"6M":-1.49160928181111E-02,"1Y":-3.80441508707789E-02,"3Y":-7.15439909199767E-02,"5Y":-5.14174442915261E-02,"10Y":-5.28115934240676E-02}}]},"factor_analysis":{"target":{"costs":5.15079365079365,"liquidity":2.77777777777778,"risk":8.21428571428572,"size":6.83333333333333,"value":5.90476190476191,"dividends":9.37301587301587,"growth":2.28571428571429,"quality":4.41269841269841,"momentum":2.49206349206349,"sentiment":2.36507936507937,"overall":3.23431531746032},"benchmark":{"costs":9.11111111111111,"liquidity":9.82539682539682,"risk":4.46031746031746,"size":2.06349206349206,"value":4.11111111111111,"dividends":8.74603174603175,"growth":7.42857142857143,"quality":8.64285714285714,"momentum":7.1984126984127,"sentiment":5.40476190476191,"overall":9.23912920634921}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":22.3855178054599},{"label":"Forward P/E","field":"forward_pe_derived","value":18.5349635303018},{"label":"Esti