{"meta":{"ticker":"UPGD","as_of_date":"2026-10-20","performance_as_of":"2026-09-30","generated_at":"2026-10-21 07:55:29"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":109856520,"holdings_count":52,"inception_date":"2006-05-19","overall_score":3.85124535714286,"overall_rank":760,"sector_diversification_score":5.74367873574715},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-09-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":-3.44149459193707E-02,"3M":-2.45620372042621E-02,"6M":0.096872461413485,"1Y":8.57048954541815E-02,"3Y":0.144284684482728,"5Y":6.81374963186514E-02,"10Y":8.98991113999059E-02}},{"label":"SPY","values":{"1M":-3.27201980898484E-03,"3M":2.37987101462438E-02,"6M":0.178605040259332,"1Y":0.157157102167488,"3Y":0.22757633319144,"5Y":0.137031443094805,"10Y":0.15242468944859}},{"label":"+/- SPY","values":{"1M":-3.11429261103858E-02,"3M":-4.83607473505059E-02,"6M":-8.17325788458474E-02,"1Y":-7.14522067133065E-02,"3Y":-8.32916487087121E-02,"5Y":-6.88939467761533E-02,"10Y":-0.062525578048684}}]},"factor_analysis":{"target":{"costs":5.10625,"liquidity":3.54732142857143,"risk":7.26785714285714,"size":6.55267857142857,"value":4.25446428571429,"dividends":8.36071428571429,"growth":2.125,"quality":4.74464285714286,"momentum":6.24732142857143,"sentiment":3.24196428571429,"overall":3.85124535714286},"benchmark":{"costs":8.91517857142857,"liquidity":9.85535714285714,"risk":4.40714285714286,"size":2.07678571428571,"value":3.89285714285714,"dividends":8.58571428571429,"growth":7.62946428571429,"quality":8.65803571428571,"momentum":8.01517857142857,"sentiment":5.75714285714286,"overall":9.48821428571429}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":24.1644943671683},{"label":"Forward P/E","field":"forward_pe_derived","value":19.544613420518},{"label":"Estimated Dividend Yiel