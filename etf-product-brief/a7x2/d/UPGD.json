{"meta":{"ticker":"UPGD","as_of_date":"2026-08-11","performance_as_of":"2026-07-31","generated_at":"2026-08-12 08:55:06"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":121608404,"holdings_count":53,"inception_date":"2006-05-19","overall_score":3.20364828621908,"overall_rank":859,"sector_diversification_score":5.88921352811687},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-07-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":1.89633375474085E-03,"3M":6.09103078982596E-02,"6M":0.070429329474192,"1Y":0.156910990734032,"3Y":0.120508413986269,"5Y":7.62098009226644E-02,"10Y":9.70940786997749E-02}},{"label":"SPY","values":{"1M":3.63339086202119E-04,"3M":4.21082513247539E-02,"6M":8.53454222923031E-02,"1Y":0.194955141604811,"3Y":0.192052404906245,"5Y":0.12762724521419,"10Y":0.149905672123843}},{"label":"+/- SPY","values":{"1M":1.53299466853873E-03,"3M":1.88020565735056E-02,"6M":-1.49160928181111E-02,"1Y":-3.80441508707789E-02,"3Y":-7.15439909199767E-02,"5Y":-5.14174442915261E-02,"10Y":-5.28115934240676E-02}}]},"factor_analysis":{"target":{"costs":5.13427561837456,"liquidity":2.90812720848057,"risk":8.09982332155477,"size":6.80388692579505,"value":6.04858657243816,"dividends":9.26060070671378,"growth":2.2482332155477,"quality":4.54593639575972,"momentum":2.60600706713781,"sentiment":2.34363957597173,"overall":3.20364828621908},"benchmark":{"costs":8.96643109540636,"liquidity":9.84098939929329,"risk":4.44257950530035,"size":2.09717314487633,"value":4.17226148409894,"dividends":8.72791519434629,"growth":7.56713780918728,"quality":8.64840989399293,"momentum":5.73056537102473,"sentiment":5.43639575971731,"overall":8.54201144876325}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":22.0439551087397},{"label":"Forward P/E","field":"forward_pe_derived","value":18.5104185600064},{"label":"Esti