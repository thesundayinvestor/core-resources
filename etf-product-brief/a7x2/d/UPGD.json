{"meta":{"ticker":"UPGD","as_of_date":"2026-08-31","performance_as_of":"2026-08-31","generated_at":"2026-09-01 09:01:19"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":120142482,"holdings_count":53,"inception_date":"2006-05-19","overall_score":3.21414391246684,"overall_rank":848,"sector_diversification_score":5.89206492335437},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-08-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":8.29202343397939E-03,"3M":1.03865606936417E-02,"6M":4.16201117318435E-02,"1Y":0.137254867894246,"3Y":0.138237618689968,"5Y":7.36859319616854E-02,"10Y":9.54118352700015E-02}},{"label":"SPY","values":{"1M":2.67865250158903E-02,"3M":1.65408126573174E-02,"6M":0.124055666003976,"1Y":0.202293314227892,"3Y":0.209188792743868,"5Y":0.126975306348125,"10Y":0.152811385025648}},{"label":"+/- SPY","values":{"1M":-1.84945015819109E-02,"3M":-6.15425196367569E-03,"6M":-8.24355542721322E-02,"1Y":-6.50384463336453E-02,"3Y":-7.09511740539008E-02,"5Y":-5.32893743864398E-02,"10Y":-5.73995497556468E-02}}]},"factor_analysis":{"target":{"costs":5.12997347480106,"liquidity":2.80636604774536,"risk":8.25729442970822,"size":6.78514588859416,"value":6.06100795755968,"dividends":9.10079575596817,"growth":2.26525198938992,"quality":4.58090185676393,"momentum":2.25729442970822,"sentiment":2.52785145888594,"overall":3.21414391246684},"benchmark":{"costs":9.06896551724138,"liquidity":9.84084880636605,"risk":4.73209549071618,"size":2.13793103448276,"value":4.23872679045093,"dividends":8.6631299734748,"growth":7.39787798408488,"quality":8.48806366047745,"momentum":7.24668435013263,"sentiment":4.88328912466844,"overall":9.24097846153846}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":21.5332830205419},{"label":"Forward P/E","field":"forward_pe_derived","value":18.2348567419373},{"label":"E