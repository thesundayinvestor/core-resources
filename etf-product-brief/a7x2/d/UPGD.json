{"meta":{"ticker":"UPGD","as_of_date":"2026-06-11","performance_as_of":"2026-05-29","generated_at":"2026-06-12 07:48:45"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":156743146,"holdings_count":53,"inception_date":"2006-05-19","overall_score":3.19821943462898,"overall_rank":863,"sector_diversification_score":5.90814896386025},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-05-29","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":5.87110346146489E-02,"3M":3.09124767225324E-02,"6M":0.111897150235174,"1Y":0.18320964124442,"3Y":0.168772702551769,"5Y":7.04117986703345E-02,"10Y":0.102545036014024}},{"label":"SPY","values":{"1M":5.26116578349736E-02,"3M":0.105765407554672,"6M":0.113345757524231,"1Y":0.298258939820464,"3Y":0.234528174943585,"5Y":0.140412510310876,"10Y":0.155593287445148}},{"label":"+/- SPY","values":{"1M":6.09937677967531E-03,"3M":-7.48529308321395E-02,"6M":-1.44860728905627E-03,"1Y":-0.115049298576044,"3Y":-6.57554723918157E-02,"5Y":-0.070000711640541,"10Y":-5.30482514311243E-02}}]},"factor_analysis":{"target":{"costs":5.15017667844523,"liquidity":2.63780918727915,"risk":8.07597173144876,"size":7.03445229681979,"value":6.46996466431095,"dividends":7.93286219081272,"growth":2.59805653710247,"quality":5.22173144876325,"momentum":1.59628975265018,"sentiment":2.32773851590106,"overall":3.19821943462898},"benchmark":{"costs":8.99028268551237,"liquidity":9.79328621908127,"risk":4.56183745583039,"size":2.16077738515901,"value":3.87014134275618,"dividends":8.82332155477032,"growth":7.62279151943463,"quality":8.53710247349823,"momentum":6.12014134275618,"sentiment":8.17137809187279,"overall":9.18945199646643}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":21.9812584630687},{"label":"Forward P/E","field":"forward_pe_derived","value":17.6633466103415},{"label":"Estimated Dividen