{"meta":{"ticker":"UPGD","as_of_date":"2026-06-30","performance_as_of":"2026-06-30","generated_at":"2026-07-01 08:23:25"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"UPGD","fund_name":"Invesco Bloomberg Analyst Rating Improvers ETF","category":"US Large-Cap Blend","issuer":"Invesco","index_name":"Bloomberg ANR Improvers Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.004,"aum":118650086,"holdings_count":52,"inception_date":"2006-05-19","overall_score":3.38001186231244,"overall_rank":832,"sector_diversification_score":5.91380894060012},"description":{"tsi_description":"UPGD is an equal-weighted large- and mid-cap ETF that selects stocks with the most improved Wall Street analyst ratings over recent six- and twelve-month periods. The fund tracks the Bloomberg ANR Improvers Index and attempts to identify companies experiencing positive shifts in analyst sentiment. Its rules-based methodology emphasizes stocks with improving consensus ratings while excluding companies with the highest existing analyst ratings. The strategy's concentrated 50-stock structure and equal-weighting approach can result in meaningful sector shifts and elevated portfolio turnover over time. Overall, UPGD offers a differentiated sentiment-driven approach to U.S. equity investing with a distinctly active profile relative to traditional benchmark ETFs.","strategy_steps":["Tracks the Bloomberg ANR Improvers Index.","Starts with securities in the Bloomberg US Large Mid Universe representing approximately the top 85% of U.S. market capitalization.","Requires a minimum 90-day average daily trading value of $10 million.","Requires securities to have analyst coverage from more than ten analysts.","Requires consensus analyst ratings between 1.01 and 3.99.","Measures analyst rating improvements over six- and twelve-month periods.","Averages six- and twelve-month rating improvements to determine final rankings.","Selects the 50 stocks with the highest average analyst rating improvements.","Uses an equal-weighting methodology.","Reconstitutes and rebalances quarterly in March, June, September, and December."],"best_for":["Sentiment investing","Tactical exposure","Active positioning"],"strengths":["Unique approach","Equal weighting","High active share"],"watchouts":["High turnover","Sector concentration","Possible weak execution"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"UPGD","values":{"1M":1.806358381502E-04,"3M":0.124492282696994,"6M":0.1074,"1Y":0.17457480372671,"3Y":0.137304144915486,"5Y":6.83886671820724E-02,"10Y":0.103426929237761}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":1.05186437489737E-02,"3M":-2.67154972883661E-02,"6M":6.49999999999995E-03,"1Y":-4.74579112314999E-02,"3Y":-6.74695611772342E-02,"5Y":-6.46089016374429E-02,"10Y":-0.050563391100475}}]},"factor_analysis":{"target":{"costs":5.16240070609003,"liquidity":2.87466902030009,"risk":8.23654015887026,"size":6.57634598411297,"value":6.19505736981465,"dividends":9.10238305383936,"growth":2.31067961165049,"quality":4.05825242718447,"momentum":3.80406001765225,"sentiment":1.42894969108561,"overall":3.38001186231244},"benchmark":{"costs":8.97528684907326,"liquidity":9.80141218005296,"risk":4.88437775816417,"size":2.27096204766108,"value":4.15357458075905,"dividends":8.86407766990291,"growth":7.55339805825243,"quality":8.35569285083848,"momentum":6.83848190644307,"sentiment":4.92409532215357,"overall":9.21137229920565}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":22.2014775292494},{"label":"Forward P/E","field":"forward_pe_derived","value":17.9172883588499},{"label":"Estimated Dividend Yield","field":"estimated