{"meta":{"ticker":"USMV","as_of_date":"2026-08-07","performance_as_of":"2026-07-31","generated_at":"2026-08-09 18:16:12"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"USMV","fund_name":"iShares MSCI USA Min Vol Factor ETF","category":"US Large-Cap Blend","issuer":"BlackRock","index_name":"MSCI USA Minimum Volatility","region":"North America","exchange":"BATS","expense_ratio":0.0015,"aum":24097612084,"holdings_count":170,"inception_date":"2011-10-18","overall_score":8.76173084805654,"overall_rank":97,"sector_diversification_score":6.93779827551634},"description":{"tsi_description":"USMV is a low-volatility equity ETF that seeks to reduce portfolio risk while maintaining broad exposure to the U.S. equity market. The fund tracks the MSCI USA Minimum Volatility Index and uses an optimization process designed to construct a portfolio with lower overall volatility characteristics than the broader market. Unlike traditional low-volatility ETFs that simply select the least volatile stocks, USMV emphasizes portfolio-level risk management and diversification, allowing it to maintain exposure to sectors like Technology while limiting excessive concentration risk. The strategy has historically delivered strong downside protection with lower drawdowns and less volatility than broad market benchmarks. Overall, USMV offers a balanced and risk-aware approach to defensive U.S. equity investing.","strategy_steps":["Tracks the MSCI USA Minimum Volatility Index.","Uses an optimization process to construct a lower-volatility portfolio relative to the broader U.S. equity market.","Targets portfolio characteristics including low beta, low volatility, low cap bias, and low idiosyncratic risk.","Evaluates portfolio risk at the aggregate portfolio level rather than selecting only low-volatility stocks.","Maintains sector constraints limiting active sector deviations to approximately +/- 5% relative to the parent index.","Uses portfolio optimization to determine constituent weights.","Includes stocks with varying individual volatility profiles if they improve overall portfolio diversification characteristics.","Rebalances and reconstitutes semi-annually in May and November."],"best_for":["Defensive investing","Risk reduction","Core exposure"],"strengths":["Low volatility","Balanced profile","Downside protection"],"watchouts":["Bull market lag","Optimization risk","Lower upside"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-07-31","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"USMV","values":{"1M":1.53130451637915E-02,"3M":3.80499405469679E-02,"6M":3.84615384615388E-02,"1Y":0.077440648891594,"3Y":0.109663285285636,"5Y":6.87497274133009E-02,"10Y":9.60493731376773E-02}},{"label":"SPY","values":{"1M":3.63339086202119E-04,"3M":4.21082513247539E-02,"6M":8.53454222923031E-02,"1Y":0.194955141604811,"3Y":0.192052404906245,"5Y":0.12762724521419,"10Y":0.149905672123843}},{"label":"+/- SPY","values":{"1M":1.49497060775894E-02,"3M":-4.05831077778607E-03,"6M":-4.68838838307644E-02,"1Y":-0.117514492713217,"3Y":-0.082389119620609,"5Y":-5.88775178008896E-02,"10Y":-5.38562989861653E-02}}]},"factor_analysis":{"target":{"costs":8.47349823321555,"liquidity":8.87897526501767,"risk":9.78533568904594,"size":4.8321554770318,"value":5.13427561837456,"dividends":7.04240282685512,"growth":5.55565371024735,"quality":6.58922261484099,"momentum":4.33922261484099,"sentiment":4.18021201413428,"overall":8.76173084805654},"benchmark":{"costs":9.1095406360424,"liquidity":9.83303886925795,"risk":4.32332155477032,"size":2.09717314487633,"value":4.13250883392226,"dividends":8.73586572438163,"growth":7.54328621908127,"quality":8.67226148409894,"momentum":6.81978798586572,"sentiment":5.92137809187279,"overall":9.1434690459364}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":23.8238372955397},{"label":"Forward P/E","field":"forward_pe_derived","va