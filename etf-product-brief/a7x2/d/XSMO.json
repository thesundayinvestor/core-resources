{"meta":{"ticker":"XSMO","as_of_date":"2026-07-24","performance_as_of":"2026-06-30","generated_at":"2026-07-25 09:17:58"},"benchmark":{"ticker":"SPY","fund_name":"State Street SPDR S&P 500 ETF"},"overview":{"ticker":"XSMO","fund_name":"Invesco S&P SmallCap Momentum ETF","category":"US Small-Cap Blend","issuer":"Invesco","index_name":"S&P SmallCap 600 Momentum Index","region":"North America","exchange":"NYSEARCA","expense_ratio":0.0036,"aum":3056857540,"holdings_count":110,"inception_date":"2005-03-03","overall_score":5.55155304042179,"overall_rank":529,"sector_diversification_score":7.06707683073229},"description":{"tsi_description":"XSMO is a small-cap momentum ETF that tracks the S&P SmallCap 600 Momentum Index and emphasizes companies with strong recent price performance. The fund applies a rules-based momentum methodology within the S&P SmallCap 600 universe, resulting in exposure to smaller companies with positive price trends and relatively strong earnings growth characteristics. Unlike many small-cap blend ETFs, XSMO maintains a more concentrated factor profile centered on momentum while still offering broad diversification across holdings. The strategy's semi-annual reconstitutions can lead to meaningful shifts in portfolio composition and relatively high turnover over time. Overall, XSMO offers targeted exposure to momentum-driven small-cap equities through a transparent indexing framework.","strategy_steps":["Tracks the S&P SmallCap 600 Momentum Index.","Starts with companies in the S&P SmallCap 600 Index.","Calculates momentum scores using one-year price returns excluding the most recent month.","Selects the top quintile of securities based on momentum score.","Includes approximately 120 holdings.","Weights securities based on the product of momentum score and market capitalization.","Applies security weight constraints during portfolio construction.","Rebalances semi-annually after the third Friday in March and September.","Maintains historically high portfolio turnover due to the momentum-based reconstitution process."],"best_for":["Momentum exposure","Small-cap investing","Tactical allocation"],"strengths":["Strong diversification","Growth exposure","Transparent process"],"watchouts":["High turnover","Small-cap risk","Momentum dependence"],"status":"complete","last_updated":"2026-05-21"},"performance":{"as_of":"2026-06-30","periods":["1M","3M","6M","1Y","3Y","5Y","10Y"],"rows":[{"label":"XSMO","values":{"1M":6.38766519823788E-02,"3M":0.233308114242481,"6M":0.3041,"1Y":0.38502178633356,"3Y":0.254051763278831,"5Y":0.122770876265465,"10Y":0.155478474180338}},{"label":"SPY","values":{"1M":-1.03380079108235E-02,"3M":0.15120777998536,"6M":0.1009,"1Y":0.22203271495821,"3Y":0.20477370609272,"5Y":0.132997568819515,"10Y":0.153990320338236}},{"label":"+/- SPY","values":{"1M":7.42146598932023E-02,"3M":8.21003342571212E-02,"6M":0.2032,"1Y":0.16298907137535,"3Y":4.92780571861113E-02,"5Y":-1.02266925540502E-02,"10Y":1.48815384210232E-03}}]},"factor_analysis":{"target":{"costs":5.88752196836555,"liquidity":4.38488576449912,"risk":6.84446397188049,"size":9.31985940246046,"value":6.88400702987698,"dividends":4.03690685413005,"growth":5.16783831282953,"quality":1.92530755711775,"momentum":7.02636203866432,"sentiment":2.39982425307557,"overall":5.55155304042179},"benchmark":{"costs":9.05096660808436,"liquidity":9.83391915641476,"risk":4.40861159929701,"size":2.16256590509666,"value":4.12390158172232,"dividends":8.89279437609842,"growth":7.46924428822496,"quality":8.50527240773286,"momentum":6.40158172231986,"sentiment":6.27504393673111,"overall":8.97157805799649}},"portfolio_characteristics":{"target":[{"label":"P/E Ratio","field":"pe_ratio_derived","value":19.5864775434778},{"label":"Forward P/E","field":"forward_pe_derived","value":17.2586862542886},{"label":"Estimated Dividend Yield","field":"estimated_dividend_yield_custom","value":6.70332402961185E-03},{"label":"Beta","field":"beta_5y_derived","value":1.09601967179696},{"label"